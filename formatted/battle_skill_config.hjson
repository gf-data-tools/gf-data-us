  {
    id: 74006801
    name: Sakura Reflection
    skill_group_id: 740068
    level: 1
    type: 1
    skill_priority: 3
    cd_type: 1
    cd_time: 600
    start_cd_time: 120
    trigger_type: 1
    trigger_target: 1
    target_select_ai: 1
    action_id: 400
    skin_name: battle_skill_config-574006801
    buff_id_self: 934:-1,935:1,936:1,1000:1,8597:-99
    description:
      '''
      Gain a shield that can absorb 20 points of damage for 5 seconds.
      If the shield breaks before it expires, increase self evasion by 50%; otherwise increase self damage by 60% for 3 seconds.
      If the shield breaks before its expires, cleanse all negative effects on self and enter Mystic Mode. If the shield lasts to the end of its duration, enter Focused Mode.
      Mystic Mode lasts for 6 seconds. For every 1% of current HP lost, increase self evasion by 1.2% for 6 seconds.
      Focused Mode lasts for 6 seconds. Attacking the same target additionally applies 6 points of Vulnerability for 6 seconds, stacking up to 10 times.
      '''
    lvup_description: Cooldown time: 20 seconds,Shield value: 20,Evasion increase: 50%,Firepower increase: 60%,Duration: 3 seconds,Evasion increase per 1% of HP lost: 1.2%,Mystic Mode and evasion increase duration: 6 seconds,Vulnerability: 6 points,Focused Mode and vulnerability duration: 6 seconds
    data_pool_1: "150,20"
    code: shield
    train_coin_type: 1
    is_switch: 1
    is_cdr: 1
    skill_lv_call: 1
    special_buff_trigger: "2"
  }
