  {
    id: 11960101
    name: Sacred Corona
    skill_group_id: 119601
    level: 1
    type: 1
    skill_priority: 2
    cd_type: 1
    cd_time: 600
    start_cd_time: 180
    trigger_type: 1
    trigger_target: 1
    target_select_ai: 1
    action_id: 3490
    is_form_action: 1
    skin_name: battle_skill_config-511960101
    buff_id_self: 4852:1,4856:-999,1023:-100
    description:
      '''
      At the start of battle, even-numbered tiles on the field (numpad layout) become Sancta Terra tiles. If there are friendly units standing on Sancta Terra tiles, gain 1 point of Sancta Potentia per second, up to a maximum of 100 points. Point increase stacks with multiple friendly units on Sancta Terra tiles.
      Allies standing on Sancta Terra tiles will not take even-numbered amounts of damage below 30 points. Normal attacks performed by friendly units standing on Sancta Terra tiles come with an Afterburn effect, dealing an additional 100 points of flat damage.
      Active: Consume all Sancta Potentia and gain 1 point in damage per point of Sancta Potentia expended, lasting for 6 seconds.
      '''
    lvup_description: Cooldown time: 20 seconds,Damage Increase: 1 points,Duration: 6 seconds
    data_pool_1: "180"
    data_pool_2: *2121
    code: SCAR_L
    train_coin_type: 1
    is_switch: 1
    is_cdr: 1
    skill_lv_call: 1
    special_buff_trigger: "2"
  }
