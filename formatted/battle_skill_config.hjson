  {
    id: 75058101
    name: Crimson Claw Marks
    skill_group_id: 750581
    level: 1
    type: 1
    skill_priority: 8
    cd_type: 1
    cd_time: 300
    start_cd_time: 90
    trigger_type: 1
    trigger_target: 1
    target_select_ai: 1
    skin_name: battle_skill_config-575058101
    buff_id_self: 8572:1
    description:
      '''
      Defense Mode ON:
      Active: Normal attacks prioritize new targets and will always hit for 3 seconds.
      Passive: Normal attacks that damage humanoid enemy units inflict Bullet Wound Bleed on targets.
      Bullet Wound Bleed: Gain 5% vulnerability and take 10 points of flat damage per second.
      Defense Mode OFF:
      Active: Normal attack damage dealt to all enemies along the line of fire behind the current target is converted to melee damage that scales with Dummy-Links for 3 seconds.
      Passive: Normal attacks that damage humanoid enemy units inflict Slash Wound Bleed on targets.
      Slash Wound Bleed: Gain 5% damage reduction and take 10 points of flat damage per second.
      Wounds take 3 seconds to heal. When an enemy gets wounded again, healing countdown is reset for both wounds at the same time. When an enemy is suffering from both debuffs, flat damage caused by both types of Bleed increases 3x.
      '''
    lvup_description: Cooldown time: 10 seconds,Vulnerability: 5%,Damage reduction: 5%,Bleed Flat Damage: 10 points,Bleed Increase Multiplier: 3x
    data_pool_1: "90"
    code: ExcutionerHalloween_2
    train_coin_type: 4
    is_switch: 1
    skill_lv_call: 2
    special_buff_trigger: "2"
