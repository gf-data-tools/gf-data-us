    buff_id_target: 8085:1,8086:1
    buff_id_self: 8085:1,8086:1
    description:
      '''
      Gain a mark when she changes targets. When Hyper Trigger is activated, grant all DEFY members a mark. When DEFY members attack, each mark deals an additional 10% damage that is guaranteed to hit and can crit. Marks last 3 seconds and can stack up to 3 times. 
       When AK-12 is on the field and her rate of fire reaches its maximum, decrease her rate of fire by 30% and increase her damage by 30%. When her critical chance reaches its maximum, decrease her critical chance by 30% and increase her critical damage by 30%. These effects last for 3 seconds.
      '''
    lvup_description: Mark duration: 3 seconds,Damage increase: 30%,Critical damage increase: 30%,Duration: 3 seconds
    code: an94s2
    train_coin_type: 1
    is_switch: 1
    skill_lv_call: 2
  }
