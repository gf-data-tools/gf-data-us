  {
    id: 90244201
    name: White Night Advent
    skill_group_id: 902442
    level: 1
    type: 1
    skill_priority: 7
    cd_type: 1
    cd_time: 540
    start_cd_time: 120
    trigger_type: 1
    trigger_target: 1
    target_select_ai: 3
    action_id: 5618
    is_form_action: 1
    skin_name: battle_skill_config-590244201
    buff_id_self: 743204:-999,743205:-999,743206:-999,7432:1,743201:1,743204:120,743205:250,743206:100
    buff_delay: 41
    description:
      '''
      Passive: Damage dealt by Alina is evenly distributed among the target's Dummy-Links. When an enemy unit has a Black Mark and a White Mark on them at the same time and Alina is on the battlefield, she detonates the marks (clearing them both) and deals 1x guaranteed <color=#db3d3d>explosive damage</color> that ignores armor.
      Active: For the next 9 seconds, her normal attack is enhanced into a three-part attack, the first two of which inflict <color=#91c1f0>melee damage</color> to a single unit, while the third part deals <color=#91c1f0>melee damage</color> in a radius of 3, while also triggering Rest In Peace. Every attack applies a permanent White Mark to the target. The damage multipliers for each part of her attack are 1.2x, 2.5x and 1x.
      '''
    lvup_description: Explosion multiplier: 1x,Duration: 9 seconds,Part 1 damage multiplier: 1.2x,Part 2 damage multiplier: 2.5x,Part 3 damage multiplier: 1x
    data_pool_1: "270"
    code: Nytow1
    train_coin_type: 4
    is_cdr: 1
    skill_lv_call: 1
    special_buff_trigger: "2"
  }
