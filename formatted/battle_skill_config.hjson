    skill_group_id: 900882
    level: 1
    type: 4
    skill_priority: 2
    cd_type: 1
    trigger_id: "50113411"
    trigger_type: 1
    trigger_target: 1
    target_select_ai: 1
    is_form_action: 1
    skin_name: battle_skill_config-590088201
    buff_id_self: 3876:10
    description:
      '''
      When aimed shots do not kill the enemy, perform a number of Follow-up Shots on the enemy equal to the amount of charge stacks or until the target is killed. Follow-up Shots are enhanced normal attacks that deal 1x damage to the enemy, are affected by armor, and can score critical hits.
       Normal attacks and skills do 5% additional damage to enemy targets with less than 50% HP.
      '''
    lvup_description: Damage increase: 5%
    code: ssmod
    train_coin_type: 1
    target_lost: 2
    interrupt_type: 2
    is_switch: 1
    skill_lv_call: 2
    special_buff_trigger: "2"
