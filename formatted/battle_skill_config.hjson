  {
    id: 100362001
    name: Seething Murderous Intent
    skill_group_id: 1003620
    level: 1
    type: 1
    skill_priority: 10
    cd_type: 1
    cd_time: 300
    start_cd_time: 120
    trigger_type: 1
    trigger_target: 1
    target_select_ai: 2
    is_form_action: 1
    buff_id_target: 9680:1000009560,9681:1000009560,9682:1000009560,9683:1000009560
    buff_id_self: 9684:1,9685:1000009528,9686:1000009529,9687:1000009530,9688:1000009531,1032:1000009561
    description:
      '''
      Passive: For every enemy killed in this battle, gain 1 stack of Amplification (damage, accuracy, and evasion increased by 10%) throughout the battle, stacking up to 5 times.
      Active: Grant all echelon members 1 stack of Amplification for 3 seconds. Immediately trigger a special self buff upon reaching enough Amplification stacks.
      Upon reaching 2 stacks, increase damage and accuracy by 50% for 5 seconds.
      Upon reaching 3 stacks, gain a shield with 5% of maximum HP and 5% damage intake reduction for 50 seconds.
      Upon reaching 4 stacks, attacks are guaranteed to crit and ignore shields for 5 seconds.
      Upon reaching 5 stacks, in the next 5, negate an instance of damage that would otherwise kill a Dummy-Link.
      (When equipped with Alloy Carabiner, gain a permanent Amplification stack at the beginning of subsequent battles for each victory in a stage, stacking up to 3 times.)
      '''
    lvup_description: Cooldown: 10 seconds,Echelon buff duration: 3s
    data_pool_1: "90"
    code: hecateskill
    train_coin_type: 1
    daynight_only: 1
    is_switch: 1
    passive_name: battle_skill_config-500362001
    is_cdr: 1
    skill_lv_call: 1
    special_buff_trigger: "2"
  }
