  {
    id: 10670101
    name: Inquisitor's Bullet
    skill_group_id: 106701
    level: 1
    type: 1
    skill_priority: 9
    cd_type: 1
    cd_time: 450
    start_cd_time: 180
    trigger_type: 1
    trigger_target: 1
    target_select_ai: 1
    action_id: 400
    skin_name: battle_skill_config-510670101
    buff_id_self: 401:1,411:1,421:1
    description: Aim for 1 second, then fire a special round at an enemy that deals 1.5x damage, inflicts 25% vulnerability, and set it as the target of focus fire, lasting 3 seconds. Depending on whether Contender is in the front/middle/back row, she will target the furthest enemy within the echelon's range/the enemy with the highest current HP/the nearest enemy respectively. If a Boss unit is present, she will prioritize the Boss. (When equipped with "TC High-Performance Exoskeleton", if the target of Inquisitor's Bullet dies while her skill is active, all other enemy units will be stunned for 2 seconds and lose their shields.
    lvup_description: Cooldown: 15s,Damage Multiplier: 1.5x,Damage Amplifier: 25%,Duration: 3s
    code: AimAttackDistanceTarge
    train_coin_type: 1
    is_cdr: 1
    skill_lv_call: 1
    special_buff_trigger: "2"
  }
