  {
    id: 75012601
    name: Creeping Mist
    skill_group_id: 750126
    level: 1
    type: 1
    skill_priority: 3
    cd_type: 1
    cd_time: 540
    start_cd_time: 180
    trigger_type: 1
    trigger_target: 1
    target_select_ai: 3
    action_id: 8157
    skin_name: battle_skill_config-575012601
    buff_id_target: 7743:1,7744:1
    description:
      '''
      Enshroud the enemy echelon in a ghostly mist, reducing enemy units' accuracy by 30% and inflicting 10% vulnerability. Enemy units take 0.1x damage that scales with Dummy-Links every second. The ghostly mist lasts 6 seconds.
       Summon 2 groups of Halloween Dinergates with a full complement of Dummies. Each Dinergate has HP that equals 5% of the Sorceress' maximum HP, 10% of her damage, and 100% of her accuracy, evasion and rate of fire. The Dinergates last for 10 seconds.
       Halloween Dinergate: After every 6 normal attacks, gain 1 extra Dummy that inherits 100% of the unit's stats , lasting for 10 seconds.
      '''
    lvup_description: Cooldown time: 18 seconds,Accuracy reduction: 30%,Damage that scales with Dummy-Links: 0.1,Maximum inherited HP: 5%
    data_pool_1: "180"
    data_pool_2: "70,110,10"
    code: Intruder_H1
    train_coin_type: 4
    is_switch: 1
    is_cdr: 1
    skill_lv_call: 1
    special_buff_trigger: "2"
  }
