  {
    id: 75084501
    name: Epic of the Hunter
    skill_group_id: 750845
    level: 1
    type: 1
    skill_priority: 5
    cd_type: 1
    cd_time: 600
    start_cd_time: 180
    trigger_type: 1
    trigger_target: 1
    target_select_ai: 6
    action_id: 8838
    is_form_action: 1
    skin_name: battle_skill_config-575084501
    buff_id_self: 9173:1
    description:
      '''
      Passive: At the start of the battle, mark enemy units in this order while prioritizing unmarked units: the enemy with the highest threat level is marked as the <color=#FF741A>Dragon</color>, the enemy with the highest damage the <color=#2AE112>Kraken</color>, and the enemy with the highest HP the <color=#FF2727>Giant</color>.
      Beowulf deals 5% more damage to marked enemies., Effects of multiple markers are stackable.
      Active: Normal attacks are enhanced to deal 80% damage that scales with Dummy-Links and come with additional guaranteed damage that equals 1% of the target's max. HP (capped at 1000). Target enemies in this order for 3 seconds: <color=#FF2727>Giant</color>, <color=#2AE112>Kraken</color>, <color=#FF741A>Dragon</color>.
      Upon defeating the <color=#FF2727>Giant</color>: gain 10 points in rate of fire stat until the end of the battle.
      Upon defeating the <color=#2AE112>Kraken</color>: gain 30 points in damage stat until the end of the battle.
      Upon defeating the <color=#FF741A>Dragon</color>: when attacking unmarked enemies, mark them as <color=#658CFF>Prey</color>.
      '''
    lvup_description: Cooldown time: 20 seconds,Damage increase: 5%,Duration: 3 seconds,ROF increase: 10 points,Accuracy increase: 20 points,Damage Increase: 30 points
    data_pool_1: "90"
    code: Beowulf
    train_coin_type: 1
    is_switch: 1
    is_cdr: 1
    skill_lv_call: 1
    special_buff_trigger: "2"
  }
