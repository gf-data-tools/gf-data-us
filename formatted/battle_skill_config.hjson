  {
    id: 90242501
    name: Blazing Frontline
    skill_group_id: 902425
    level: 1
    type: 1
    skill_priority: 2
    cd_type: 1
    cd_time: 90
    trigger_type: 1
    trigger_target: 1
    target_select_ai: 3
    action_id: 400
    skin_name: battle_skill_config-590242501
    buff_id_target: 743001:-1
    buff_id_self: 743005:1,10002:1
    description:
      '''
      Passive: SGs on this unit's buff tiles gain a formation buff - whenever any units take damage, a teddy bear plushie appears in front of them and attracts enemy targeting. This effect can only trigger once every 15 seconds. The bear has 5% of this unit's max HP, 50% of her evasion and armor and lasts 5 seconds. 
      Active: Click the skill icon to toggle between different attack modes. Continuous Mode (default): reduce self damage and accuracy by 30% and increase the interval between attacks by 50%. Reloading is not needed in this mode.
      Burst Mode: Increase critical chance by 10% and critical damage by 20% and prioritize the enemy unit with the highest HP. After every 3 shots, the next shot does double damage.
      '''
    lvup_description: Damage and accuracy reduction: 30%,Attack interval increase 50%,Critical rate increase: 10%,Critical damage increase: 20%
    code: rpk203
    train_coin_type: 1
    is_switch: 1
    is_manual: 1
    is_cdr: 1
    skill_lv_call: 1
    special_buff_trigger: "2"
  }
