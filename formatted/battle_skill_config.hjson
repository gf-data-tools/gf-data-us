  {
    id: 75048301
    name: B-52 Improved Drone
    skill_group_id: 750483
    level: 1
    type: 1
    skill_priority: 10
    cd_type: 1
    cd_time: 300
    start_cd_time: 120
    trigger_id: "750483"
    trigger_type: 1
    trigger_target: 1
    target_select_ai: 1
    action_id: 400
    is_form_action: 1
    skin_name: battle_skill_config-575048301
    buff_id_self: 8360:1
    description:
      '''
      Passive: At the start of the battle, if rate of fire exceeds 40 points, gain own tile buff effects.
      Active: Build a B-52 Improved Drone to assist in the battle. Drones take 100% more damage, cannot receive stat buffs, and disappear if MK3A1 leaves the battle.
      1st use: Build a B-52 Improved Drone in front of self that inherits 50% of own current stats. This Drone cannot attack and lasts for 3 seconds.
      2nd use: Build another Drone that can attack with a piercing laser which travels through enemies and does 100% damage that scales with Dummy-Links and ignores armor. This Drone lasts for 3 seconds.
      3rd use: Build one last drone that can perform normal attacks and lasts for the rest of the battle. The active skill can only be used 3 times.
      '''
    lvup_description: Cooldown time: 10 seconds,Inherited stats: 50%,Duration: 3 seconds,Damage dealt: 100%
    code: MK3A1
    train_coin_type: 1
    is_switch: 1
    is_cdr: 1
    skill_lv_call: 1
    special_buff_trigger: "2"
  }
