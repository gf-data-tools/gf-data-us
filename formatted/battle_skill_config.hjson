  {
    id: 75062401
    name: Corrosion Protocol
    skill_group_id: 750624
    level: 1
    type: 2
    skill_priority: 8
    cd_type: 1
    cd_time: 99999
    trigger_type: 1
    trigger_target: 1
    target_select_ai: 1
    action_id: 8544
    skin_name: battle_skill_config-575062401
    description:
      '''
      Support friendly echelons within a 2-node distance when they enter battle.
      At the start of the battle, infect the enemy unit with the highest threat and enemies summoned mid-battle with Stun Corrosion.
      Stun Corrosion:
      Lose 10 HP every 0.33 seconds, being stunned for 1 second upon getting infected for the first time.
      Spread to units within a 2.5-unit radius every 3 seconds or when an infected unit dies.
      If the spread is caused by the death of an infected unit, additionally inflict 1% damage reduction to targets for 3 seconds, stacking up to 10 times.
      '''
    lvup_description: Corrosion damage: 10 points,Damage decrease: 1%,Duration: 3 seconds
    code: Nyto_tareus2
    train_coin_type: 4
    is_switch: 1
    skill_lv_call: 2
  }
