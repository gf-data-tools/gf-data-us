  {
    id: 75018801
    name: Consider It Done
    skill_group_id: 750188
    level: 1
    type: 2
    skill_priority: 5
    cd_type: 1
    trigger_id: "750188"
    trigger_type: 1
    trigger_target: 1
    target_select_ai: 1
    skin_name: battle_skill_config-575018801
    buff_id_self: 7788:1
    description:
      '''
      Increase move speed by 6 points when moving. Depending on her position on the battlefield, apply different buffs on allies:
       When on the front row, increase self armor by 10% and grant other SG T-Dolls on the same row a 4-point shield every second, stacking up to 5 times;
       When on the back row, increase self damage by 10%, increase accuracy and critical rate of MG T-Dolls on the same row by 20 points and 10% respectively.
      '''
    lvup_description: Armor increase: 10%,Shield increase: 4 points,Damage increase: 10%,Accuracy increase: 20 points,Critical rate increase: 10%
    code: NOVA
    train_coin_type: 1
    is_switch: 1
    is_cdr: 1
    skill_lv_call: 1
  }
