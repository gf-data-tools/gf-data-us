  {
    id: 75709701
    name: Fiery Dance
    skill_group_id: 757097
    level: 1
    type: 1
    skill_priority: 2
    cd_type: 1
    start_cd_time: 30
    trigger_type: 1
    trigger_target: 1
    target_select_ai: 2
    action_id: 8591
    skin_name: battle_skill_config-575709701
    description:
      '''
      After every 6 second, execute a dance move that generates 20 heat points, and also adds 8 points to all friendly units' shields for 20 seconds.
      When heat points reach 100, increase all friendly units' damage, rate of fire, evasion, and armor by 10% for 3 seconds, then reset heat points.
      If there are no fewer than 7 friendly units on the battlefield, dance moves generate 30 additional heat points.
      '''
    lvup_description: Command cost: 1,Shield point increase: 8,Stat increase: 10%,Duration: 3 seconds
    code: DRBird
    train_coin_type: 1
    target_lost: 2
    is_switch: 1
    consumption: 1
  }
