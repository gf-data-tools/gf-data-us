    skin_name: battle_skill_config-575047301
    description:
      '''
      At the start of each battle, gain 1 and 2 Notes for each MG Doll and each SG Doll on the battlefield respectively. If SPAS-12 is present, gain an additional 3 Notes.
      Each Note grants self a 1% reduction in damage intake, as well as a different effect depending on the number of Notes.
       Under 6 Notes: Increase self damage by 30% for the entire battle.
       6 or 7 Notes: Grant 9 additional ammo to the entire echelon. 
      Above 7 Notes: All SG Dolls gain 9 points of movement speed, 50 points of armor, and a 100-point shield for 40 seconds.
      '''
    lvup_description: Damage intake reduction per Note: 1%,Damage increase: 30%,Extra shots: 9 shots,Armor increase: 50 points,Shield granted: 100 points
    code: SPAS15
    train_coin_type: 1
    is_switch: 1
    is_cdr: 1
    skill_lv_call: 1
    special_buff_trigger: "2"
  }
