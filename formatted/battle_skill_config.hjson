  {
    id: 75007501
    name: Careless Spender Negotiation
    skill_group_id: 750075
    level: 1
    type: 1
    skill_priority: 5
    cd_type: 1
    cd_time: 240
    start_cd_time: 120
    trigger_type: 1
    trigger_target: 1
    target_select_ai: 623
    action_id: 400
    skin_name: battle_skill_config-575007501
    buff_id_target: 7712:1,7713:1
    buff_id_self: 7719:1,7721:1,1001:1,7724:1
    description:
      '''
      Mark the enemy unit with the highest current HP and prioritize attacking that unit for 3 seconds (prioritize boss units). In the first 3 seconds, all normal attacks can penetrate shields and are guaranteed to hit and crit.
       After 3 seconds,
       if the marked target is still on the battlefield: apply 16% vulnerability and taunt to the marked target, directing all allies to focus fire on the unit, lasting for 3 seconds;
       if the marked target is killed or no longer present: reduce all allies' current skill cooldowns by 16%.
      '''
    lvup_description: Vulnerability effect: 16%,Duration: 3 seconds,Echelon-wide cooldown reduction: 16%
    data_pool_1: "180,90"
    code: SR2
    train_coin_type: 1
    is_switch: 1
    is_cdr: 1
    skill_lv_call: 1
    special_buff_trigger: "2"
  }
