  {
    id: 74000401
    name: Refuge Consensus
    skill_group_id: 740004
    level: 1
    type: 2
    skill_priority: 10
    cd_type: 1
    start_cd_time: 15
    trigger_id: "740004,740020"
    trigger_type: 6
    trigger_target: 1
    trigger_parameter: "1"
    trigger_buff_id: 7727
    target_select_ai: 1
    skin_name: battle_skill_config-574000401
    buff_id_self: 7729:1,7727:-1
    description:
      '''
      At the start of the battle, sacrifice 50 HP to gain "Refuge" buff. While the Refuge buff is in effect, this unit does not lose Dummy-Links.
       The duration of the Refuge buff is determined by the number of AR and SMG units on the battlefield: each AR/SMG unit present (including self) increases the duration by 2 seconds.
       Every victorious battle in the same map shortens the duration by 20%, stacking up to 3 times.
      '''
    lvup_description: Refuge buff duration with each AR/SMG unit present: 2 seconds
    data_pool_1: *4211
    code: G36CMOD
    train_coin_type: 1
    daynight_only: 1
    is_switch: 1
    skill_lv_call: 2
  }
