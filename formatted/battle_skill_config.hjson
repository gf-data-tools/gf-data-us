    target_select_ai: 23
    action_id: 8834
    skin_name: battle_skill_config-575083701
    buff_id_self: 9164:1,9187:1,1000005351:1
    description:
      '''
      <color=#FFB300>Activation interval 2 seconds</color>
      Passive: Gain 1 charges every 4 seconds. If there are enemy units within a distance of 5 ahead of self, gain 1 additional charges.
      Active: Consume 1 charges and throw a grenade, dealing 215% damage that scales with Dummy-Links to enemy units within a radius of 2.5.,Gain an ability upgrade with every 2 grenades thrown, up to a maximum of 3 upgrades.
      Ability Upgrade I: grenade AoE is enlarged to 4;
      Ability Upgrade II: damage against enemies with no Dummy-Links increases by 50%.
      Ability Upgrade III: gain a shield with 3.5% of max. HP for every group of enemies blasted by her grenades, stacking up to 6 times.
      '''
    lvup_description: Dummy-scaling damage multiplier: 215%,Increase of grenade damage to enemies with no Dummy-Links: 50%,Shield multiplier: 3.5%
    data_pool_1: *5331,*5334
    data_pool_2: *5353
    code: 82types
    train_coin_type: 1
    is_switch: 1
    is_cdr: 1
    skill_lv_call: 1
    special_buff_trigger: "2"
  }
