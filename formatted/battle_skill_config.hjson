  {
    id: 90230401
    name: Hunting Time
    skill_group_id: 902304
    level: 1
    type: 1
    skill_priority: 2
    cd_type: 1
    cd_time: 300
    start_cd_time: 180
    trigger_type: 1
    trigger_target: 1
    target_select_ai: 3
    action_id: 400
    is_form_action: 1
    skin_name: battle_skill_config-590230401
    buff_id_target: 7192:-1,719202:-1,719205:-1
    buff_id_self: 719203:-1,719201:1,719502:-999,719501:1,719502:6,1000:1,719204:1
    description:
      '''
      Passive: At the start of the battle, randomly select an enemy unit as "prey". Killing the prey increases self damage by 30% and accuracy by 4% for the duration of the battle. When the prey is killed, another living enemy unit is chosen as prey.
       Active: Activate Hunting Time and immediately redesignate the enemy unit with the highest HP as the prey. Attacks focus on that unit until it dies. While this skill is in effect, every attack increases self damage by 6%, stacking up to 5 times. Hunting Time lasts for 3 seconds or until the current prey is killed.
      '''
    lvup_description: Cooldown time: 10 seconds,Damage increase: 30%,Accuracy increase: 4 points,Hunting Time damage increase: 6%,Hunting Time duration: 3 seconds
    data_pool_1: "90"
    code: Sav99
    train_coin_type: 1
    daynight_only: 1
    is_switch: 1
    is_cdr: 1
    skill_lv_call: 1
    special_buff_trigger: "2"
  }
