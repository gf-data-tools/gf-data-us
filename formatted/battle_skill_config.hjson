  {
    id: 75092301
    name: Death Knell
    skill_group_id: 750923
    level: 1
    type: 2
    skill_priority: 5
    cd_type: 1
    trigger_id: "750923"
    trigger_type: 1
    trigger_target: 1
    target_select_ai: 1
    is_form_action: 1
    skin_name: battle_skill_config-575092301
    buff_id_self: 9321:100,9322:30,9323:10,9324:30
    description:
      '''
      At the start of the battle, if there are no other Dolls on adjacent tiles, reload time is fixed at 2 seconds.
      Each attack will consume all ammo, dealing 5x damage. If 10 or more rounds are consumed, also reduce the target's damage by 10% for 1 second.
      After each reload, gain a shield with HP that equals 1x her ammo capacity, lasting 1 seconds.
      '''
    lvup_description: Additional damage reduction: 10%,Ammo-to-shield multiplier: 1x,Shield duration: 1 seconds
    code: Stevens520
    train_coin_type: 1
    is_switch: 1
    is_cdr: 1
    skill_lv_call: 1
    special_buff_trigger: "2"
  }
