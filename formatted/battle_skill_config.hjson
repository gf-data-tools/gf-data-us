    skin_name: battle_skill_config-575062201
    buff_id_self: 8636:1,8642:1,8643:1
    description:
      '''
      Prioritize the boss of enemy unit with the highest threat, dealing three-part 3x guaranteed single-target damage that ignores armor, and an instance of 1x splash damage that scales with Dummy-Links to enemies within a 4-unit radius around the target.
      Deploy a 1000-point energy-absorbing shield with taunt effect in front of allies on the front row for 5 seconds. After the shield disappears, Tareus enters High-Power Mode for 6 seconds.
      High-Power Mode:
      Shots fired from her railgun are enhanced with piercing damage.
      Charging time of her particle cannon is reduced to 3 seconds.
      The one-shot threshold of her sniper rifle is increased to 25% of enemy HP.
      '''
    lvup_description: Cooldown time: 30 seconds,Single-target Damage Multiplier: 3x,Splash Damage Multiplier: 1x,High-Power Mode Duration: 6 seconds
    data_pool_1: "125"
    data_pool_2: "300,100"
    code: Nyto_tareus1
    train_coin_type: 4
    is_cdr: 1
    skill_lv_call: 1
    special_buff_trigger: "2"
  }
