  {
    id: 11050101
    name: Forewarning
    skill_group_id: 110501
    level: 1
    type: 1
    skill_priority: 2
    cd_type: 1
    cd_time: 600
    start_cd_time: 150
    trigger_type: 1
    trigger_target: 1
    target_select_ai: 3
    action_id: 1317
    skin_name: battle_skill_config-511050101
    buff_id_self: 884:1,885:1
    description:
      '''
