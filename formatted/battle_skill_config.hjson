  {
    id: 90104101
    name: Clearance Protocol
    skill_group_id: 901041
    level: 1
    type: 2
    skill_priority: 10
    cd_type: 1
    trigger_id: "50113487"
    trigger_type: 1
    trigger_target: 1
    target_select_ai: 1
    action_id: 5412
    skin_name: battle_skill_config-590104101
    buff_id_self: 3978:1,397801:1
    description:
      '''
      Default: Once the battle starts, continuously produce Goliath reinforcements at a rate dependent on self attack speed. Each Goliath has 10 points of move speed and inherits 30% of the Goliath Factory's HP and 10% of its damage. All other stats are the same as the main unit.
      Upon contact with the enemy or upon reaching their maximum range, Goliaths immediately self-destruct, dealing 12x <color=#db3d3d>explosive damage</color> to all enemies within a radius of 3 units. In Defense and Charge Modes, Goliaths will move forward until they come into contact with an enemy; in Destroy Mode they will seek out the closest enemy unit.
      '''
    lvup_description: Inherited HP: 30%,Damage multiplier: 12x
    data_pool_1: *3728
    code: mantic2
    train_coin_type: 4
    is_switch: 1
    skill_lv_call: 4
  }
