    trigger_target: 1
    target_select_ai: 1
    skin_name: battle_skill_config-575044401
    buff_id_self: 1000004574:1,8331:-5
    description:
      '''
      Every 4 spawns of Shark Volleyballs has a chance to additionally spawn a Blue Shark Volleyball or a Yellow Shark Volleyball.
      Blue Shark Volleyball: Move to the allied unit with the lowest HP percentage and grant a 30-point shield to all friendly units within a 3-unit radius for 5 seconds. Units shielded in this way gain 10 points of evasion while the shield exists. Alina – Mosasaur Rider gains double the effect.
      Yellow Shark Volleyball: Move to the enemy unit with the highest DPS and stun all enemy units within a 1-unit radius for 2 seconds. If Alina – Mosasaur Rider is present, stun them for 4 seconds instead.
      '''
    lvup_description: Frequency: Every 4 times,Shield Value: 30 points,Additional Evasion: 10 points
    code: RecceCentreSwim_2
    train_coin_type: 4
    is_switch: 1
    skill_lv_call: 4
  }
