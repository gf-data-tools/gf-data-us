  {
    id: 11560201
    name: Sundering Shockwave
    skill_group_id: 115602
    level: 1
    type: 1
    skill_priority: 10
    cd_type: 1
    cd_time: 300
    start_cd_time: 120
    trigger_type: 6
    trigger_target: 1
    trigger_parameter: "1"
    target_select_ai: 1
    action_id: 400
    is_form_action: 1
    skin_name: battle_skill_config-511560201
    buff_id_self: 4156:1
    description:
      '''
      Throw a hand grenade across a distance of 5 units ahead of self, dealing 2x damage to enemies in a 2.5 radius and inflicting knockback of 3- units.
       When in the middle row, enemies are knocked to both sides. When in the top or bottom row, enemies are knocked into the center. This knockback effect does not affect units which are attacking or using skills. (After the SAF chip is equipped, grenade damage is increased by 100% and enemies are stunned for 3 seconds after being knocked back.)
      '''
    lvup_description: Cooldown time: 10 seconds,Damage multiplier: 2x
    code: SAF
    train_coin_type: 1
    is_switch: 1
    is_cdr: 1
    skill_lv_call: 1
    special_buff_trigger: "2"
  }
